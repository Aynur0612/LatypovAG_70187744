// Общий модуль: АналитикаИПечатьОтчетовКуратора
// Назначение: Формирование 5 аналитических отчетов модуля «Рабочий стол куратора»
// с обращением к специализированным регистрам накопления и сведений и выводом
// печатных форм в формате ТабличныйДокумент.
// Автор разработки: Латыпов Айнур Гиндуллович (ID 70187744)
// =============================================================================

// Вспомогательная процедура оформления заголовка печатной формы отчета СПК
Процедура ОформитьШапкуОтчетаСПК(ТабДок, ЗаголовокОтчета, Подзаголовок) Экспорт
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.Область("C1").ШиринаКолонки = 26;
	ТабДок.Область("C2").ШиринаКолонки = 24;
	ТабДок.Область("C3").ШиринаКолонки = 28;
	ТабДок.Область("C4").ШиринаКолонки = 16;
	ТабДок.Область("C5").ШиринаКолонки = 16;
	ТабДок.Область("C6").ШиринаКолонки = 26;
	ШрифтОрг = Новый Шрифт("Times New Roman", 10, Ложь);
	ШрифтЗаг = Новый Шрифт("Times New Roman", 13, Истина);
	ШрифтПодз = Новый Шрифт("Times New Roman", 10, Ложь, Истина);

	ОблОрг = ТабДок.Область("R1C1:R1C6");
	ОблОрг.Объединить();
	ОблОрг.Шрифт = ШрифтОрг;
	ОблОрг.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОблОрг.Текст = "АУ «Сургутский политехнический колледж» | Модуль «Рабочий стол куратора»";

	ОблЗаг = ТабДок.Область("R2C1:R2C6");
	ОблЗаг.Объединить();
	ОблЗаг.Шрифт = ШрифтЗаг;
	ОблЗаг.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОблЗаг.Текст = ЗаголовокОтчета;

	ОблПодз = ТабДок.Область("R3C1:R3C6");
	ОблПодз.Объединить();
	ОблПодз.Шрифт = ШрифтПодз;
	ОблПодз.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОблПодз.Текст = Подзаголовок + " (сформировано: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ")";
КонецПроцедуры

// Отчет №1 (сложный): Сводная ведомость посещаемости и пропусков по группам
// Обращается к 4 объектам: РегистрНакопления.УчетПосещаемостиИПропусков,
// Справочник.Студенты, Справочник.УчебныеГруппы, Справочник.СтруктурныеПодразделения
Функция СформироватьОтчетПосещаемость() Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ПорогЧасов = Константы.ПорогКритическихПропусковЧасов.Получить();
	Если ПорогЧасов <= 0 Тогда
		ПорогЧасов = 36;
	КонецЕсли;
	ОформитьШапкуОтчетаСПК(ТабДок, "СВОДНАЯ ВЕДОМОСТЬ ПОСЕЩАЕМОСТИ И ПРОПУСКОВ ЗАНЯТИЙ",
		"Контрольный порог критических пропусков без уважительной причины: " + Формат(ПорогЧасов, "ЧГ=0") + " ч.");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Обороты.УчебнаяГруппа.СтруктурноеПодразделение.Наименование КАК Подразделение,
		|	Обороты.УчебнаяГруппа.Наименование КАК Группа,
		|	Обороты.Студент.Наименование КАК СтудентФИО,
		|	СУММА(Обороты.ЧасыПропусковВсегоОборот) КАК ЧасыВсего,
		|	СУММА(Обороты.ЧасыБезУважительнойПричиныОборот) КАК ЧасыНеуваж,
		|	СУММА(Обороты.КоличествоОпозданийОборот) КАК Опоздания
		|ИЗ
		|	РегистрНакопления.УчетПосещаемостиИПропусков.Обороты КАК Обороты
		|СГРУППИРОВАТЬ ПО
		|	Обороты.УчебнаяГруппа.СтруктурноеПодразделение.Наименование,
		|	Обороты.УчебнаяГруппа.Наименование,
		|	Обороты.Студент.Наименование
		|УПОРЯДОЧИТЬ ПО
		|	Группа,
		|	ЧасыНеуваж УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();

	ШрифтШапкиТабл = Новый Шрифт("Times New Roman", 10, Истина);
	ШрифтСтроки = Новый Шрифт("Times New Roman", 10, Ложь);
	ЛинияСетки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	Заголовки = Новый Массив;
	Заголовки.Добавить("Структурное подразделение");
	Заголовки.Добавить("Группа");
	Заголовки.Добавить("ФИО обучающегося");
	Заголовки.Добавить("Пропущено всего, ч");
	Заголовки.Добавить("Без уваж. причины, ч");
	Заголовки.Добавить("Опозданий / Статус");

	Для Индекс = 1 По 6 Цикл
		Яч = ТабДок.Область("R5C" + Формат(Индекс, "ЧГ=0"));
		Яч.Шрифт = ШрифтШапкиТабл;
		Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Яч.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Яч.Текст = Заголовки[Индекс - 1];
		Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
	КонецЦикла;

	Стр = 6;
	Пока Выборка.Следующий() Цикл
		СтатусКонтроля = ?(Выборка.ЧасыНеуваж >= ПорогЧасов, "ТРЕБУЕТСЯ ПРОФИЛАКТИКА", "Норма");
		Значения = Новый Массив;
		Значения.Добавить(Выборка.Подразделение);
		Значения.Добавить(Выборка.Группа);
		Значения.Добавить(Выборка.СтудентФИО);
		Значения.Добавить(Формат(Выборка.ЧасыВсего, "ЧГ=0"));
		Значения.Добавить(Формат(Выборка.ЧасыНеуваж, "ЧГ=0"));
		Значения.Добавить(Формат(Выборка.Опоздания, "ЧГ=0") + " (" + СтатусКонтроля + ")");
		Для Индекс = 1 По 6 Цикл
			Яч = ТабДок.Область("R" + Формат(Стр, "ЧГ=0") + "C" + Формат(Индекс, "ЧГ=0"));
			Яч.Шрифт = ШрифтСтроки;
			Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Яч.Текст = Значения[Индекс - 1];
			Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
		КонецЦикла;
		Стр = Стр + 1;
	КонецЦикла;
	Возврат ТабДок;
КонецФункции

// Отчет №2 (сложный): Анализ успеваемости и академических задолженностей
// Обращается к 4 объектам: РегистрСведений.СводныеПоказателиУспеваемостиИЗадолженностей,
// Справочник.Студенты, Справочник.УчебныеГруппы, Справочник.УчебныеДисциплины
Функция СформироватьОтчетУспеваемость() Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ОформитьШапкуОтчетаСПК(ТабДок, "АНАЛИЗ УСПЕВАЕМОСТИ И АКАДЕМИЧЕСКИХ ЗАДОЛЖЕННОСТЕЙ ОБУЧАЮЩИХСЯ",
		"Сводка по среднему баллу и неаттестованным дисциплинам по курсам обучения");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Рег.Студент.УчебнаяГруппа.Наименование КАК Группа,
		|	Рег.Студент.Наименование КАК СтудентФИО,
		|	Рег.Курс КАК Курс,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Рег.УчебнаяДисциплина) КАК ВсегоДисциплин,
		|	СРЕДНЕЕ(Рег.СреднийБалл) КАК СреднийБалл,
		|	СУММА(ВЫБОР КОГДА Рег.НеАттестован ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ЧислоЗадолженностей
		|ИЗ
		|	РегистрСведений.СводныеПоказателиУспеваемостиИЗадолженностей КАК Рег
		|СГРУППИРОВАТЬ ПО
		|	Рег.Студент.УчебнаяГруппа.Наименование,
		|	Рег.Студент.Наименование,
		|	Рег.Курс
		|УПОРЯДОЧИТЬ ПО
		|	Группа,
		|	ЧислоЗадолженностей УБЫВ,
		|	СтудентФИО";
	Выборка = Запрос.Выполнить().Выбрать();

	ШрифтШапкиТабл = Новый Шрифт("Times New Roman", 10, Истина);
	ШрифтСтроки = Новый Шрифт("Times New Roman", 10, Ложь);
	ЛинияСетки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	Заголовки = Новый Массив;
	Заголовки.Добавить("Учебная группа");
	Заголовки.Добавить("ФИО обучающегося");
	Заголовки.Добавить("Курс");
	Заголовки.Добавить("Дисциплин в учете");
	Заголовки.Добавить("Средний балл");
	Заголовки.Добавить("Неаттестовано дисциплин");

	Для Индекс = 1 По 6 Цикл
		Яч = ТабДок.Область("R5C" + Формат(Индекс, "ЧГ=0"));
		Яч.Шрифт = ШрифтШапкиТабл;
		Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Яч.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Яч.Текст = Заголовки[Индекс - 1];
		Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
	КонецЦикла;

	Стр = 6;
	Пока Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Значения.Добавить(Выборка.Группа);
		Значения.Добавить(Выборка.СтудентФИО);
		Значения.Добавить(Формат(Выборка.Курс, "ЧГ=0"));
		Значения.Добавить(Формат(Выборка.ВсегоДисциплин, "ЧГ=0"));
		Значения.Добавить(Формат(Выборка.СреднийБалл, "ЧДЦ=2;ЧРД=,"));
		Значения.Добавить(Формат(Выборка.ЧислоЗадолженностей, "ЧГ=0"));
		Для Индекс = 1 По 6 Цикл
			Яч = ТабДок.Область("R" + Формат(Стр, "ЧГ=0") + "C" + Формат(Индекс, "ЧГ=0"));
			Яч.Шрифт = ШрифтСтроки;
			Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Яч.Текст = Значения[Индекс - 1];
			Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
		КонецЦикла;
		Стр = Стр + 1;
	КонецЦикла;
	Возврат ТабДок;
КонецФункции

// Отчет №3 (сложный): Рейтинг воспитательной и общественной активности студентов
// Обращается к 4 объектам: РегистрНакопления.РейтингВоспитательнойАктивности,
// Справочник.Студенты, Справочник.УчебныеГруппы, Справочник.ОбщественныеПоручения
Функция СформироватьОтчетРейтингАктивности() Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ОформитьШапкуОтчетаСПК(ТабДок, "РЕЙТИНГ ВОСПИТАТЕЛЬНОЙ И ОБЩЕСТВЕННОЙ АКТИВНОСТИ ОБУЧАЮЩИХСЯ",
		"Учет участия в спартакиадах, олимпиадах, ВПК «Росич» и общественных поручениях групп");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ост.УчебнаяГруппа.Наименование КАК Группа,
		|	Ост.Студент.Наименование КАК СтудентФИО,
		|	Ост.Студент.ОбщественноеПоручение.Наименование КАК Поручение,
		|	СУММА(Ост.КоличествоМероприятийОборот) КАК Мероприятий,
		|	СУММА(Ост.БаллыАктивностиКонечныйОстаток) КАК ИтоговыйРейтинг,
		|	МАКСИМУМ(Ост.ВидМероприятия.Наименование) КАК КлючевоеМероприятие
		|ИЗ
		|	РегистрНакопления.РейтингВоспитательнойАктивности.ОстаткиИОбороты КАК Ост
		|СГРУППИРОВАТЬ ПО
		|	Ост.УчебнаяГруппа.Наименование,
		|	Ост.Студент.Наименование,
		|	Ост.Студент.ОбщественноеПоручение.Наименование
		|УПОРЯДОЧИТЬ ПО
		|	ИтоговыйРейтинг УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();

	ШрифтШапкиТабл = Новый Шрифт("Times New Roman", 10, Истина);
	ШрифтСтроки = Новый Шрифт("Times New Roman", 10, Ложь);
	ЛинияСетки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	Заголовки = Новый Массив;
	Заголовки.Добавить("Группа");
	Заголовки.Добавить("ФИО обучающегося");
	Заголовки.Добавить("Общественное поручение");
	Заголовки.Добавить("Мероприятий");
	Заголовки.Добавить("Рейтинговый балл");
	Заголовки.Добавить("Ключевое мероприятие");

	Для Индекс = 1 По 6 Цикл
		Яч = ТабДок.Область("R5C" + Формат(Индекс, "ЧГ=0"));
		Яч.Шрифт = ШрифтШапкиТабл;
		Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Яч.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Яч.Текст = Заголовки[Индекс - 1];
		Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
	КонецЦикла;

	Стр = 6;
	Пока Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Значения.Добавить(Выборка.Группа);
		Значения.Добавить(Выборка.СтудентФИО);
		Значения.Добавить(?(ЗначениеЗаполнено(Выборка.Поручение), Выборка.Поручение, "Исполнитель"));
		Значения.Добавить(Формат(Выборка.Мероприятий, "ЧГ=0"));
		Значения.Добавить(Формат(Выборка.ИтоговыйРейтинг, "ЧДЦ=1;ЧРД=,"));
