	Возврат ТабДок;
КонецФункции

// Отчет №4 (сложный): Мониторинг дисциплины и индивидуальной профилактической работы
// Обращается к 4 объектам: РегистрНакопления.УчетДисциплинарныхЗамечанийИМер,
// РегистрСведений.ПсихологоПедагогическийПрофильСтудентов, Справочник.Студенты, Справочник.УчебныеГруппы
Функция СформироватьОтчетМониторингДисциплины() Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ОформитьШапкуОтчетаСПК(ТабДок, "МОНИТОРИНГ ДИСЦИПЛИНЫ И ИНДИВИДУАЛЬНОЙ ПРОФИЛАКТИЧЕСКОЙ РАБОТЫ",
		"Контроль замечаний преподавателей, профилактических бесед и взаимодействия с родителями");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Дисц.УчебнаяГруппа.Наименование КАК Группа,
		|	Дисц.Студент.Наименование КАК СтудентФИО,
		|	Дисц.ВидЗамечания.Наименование КАК ВидВоздействия,
		|	СУММА(Дисц.КоличествоЗамечанийОборот) КАК Замечаний,
		|	СУММА(Дисц.КоличествоПрофилактическихБеседОборот) КАК Бесед,
		|	СУММА(Дисц.ШтрафныеБаллыДисциплиныОборот) КАК ШтрафБалл
		|ИЗ
		|	РегистрНакопления.УчетДисциплинарныхЗамечанийИМер.Обороты КАК Дисц
		|СГРУППИРОВАТЬ ПО
		|	Дисц.УчебнаяГруппа.Наименование,
		|	Дисц.Студент.Наименование,
		|	Дисц.ВидЗамечания.Наименование
		|УПОРЯДОЧИТЬ ПО
		|	Замечаний УБЫВ,
		|	СтудентФИО";
	Выборка = Запрос.Выполнить().Выбрать();

	ШрифтШапкиТабл = Новый Шрифт("Times New Roman", 10, Истина);
	ШрифтСтроки = Новый Шрифт("Times New Roman", 10, Ложь);
	ЛинияСетки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	Заголовки = Новый Массив;
	Заголовки.Добавить("Группа");
	Заголовки.Добавить("ФИО обучающегося");
	Заголовки.Добавить("Вид замечания / меры");
	Заголовки.Добавить("Замечаний");
	Заголовки.Добавить("Проведено бесед");
	Заголовки.Добавить("Штрафной индекс");

	Для Индекс = 1 По 6 Цикл
		Яч = ТабДок.Область("R5C" + Формат(Индекс, "ЧГ=0"));
		Яч.Шрифт = ШрифтШапкиТабл;
		Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Яч.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Яч.Текст = Заголовки[Индекс - 1];
		Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
	КонецЦикла;

	Стр = 6;
	Пока Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Значения.Добавить(Выборка.Группа);
		Значения.Добавить(Выборка.СтудентФИО);
		Значения.Добавить(Выборка.ВидВоздействия);
		Значения.Добавить(Формат(Выборка.Замечаний, "ЧГ=0"));
		Значения.Добавить(Формат(Выборка.Бесед, "ЧГ=0"));
		Значения.Добавить(Формат(Выборка.ШтрафБалл, "ЧДЦ=1;ЧРД=,"));
		Для Индекс = 1 По 6 Цикл
			Яч = ТабДок.Область("R" + Формат(Стр, "ЧГ=0") + "C" + Формат(Индекс, "ЧГ=0"));
			Яч.Шрифт = ШрифтСтроки;
			Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Яч.Текст = Значения[Индекс - 1];
			Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
		КонецЦикла;
		Стр = Стр + 1;
	КонецЦикла;
	Возврат ТабДок;
КонецФункции

// Отчет №5: Реестр сформированных и утвержденных характеристик студентов
Функция СформироватьОтчетРеестрХарактеристик() Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ОформитьШапкуОтчетаСПК(ТабДок, "РЕЕСТР СФОРМИРОВАННЫХ И УТВЕРЖДЕННЫХ ХАРАКТЕРИСТИК ОБУЧАЮЩИХСЯ",
		"Журнал выдачи характеристик по учебным группам АУ «Сургутский политехнический колледж»");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Номер КАК Номер,
		|	Док.Дата КАК Дата,
		|	Док.УчебнаяГруппа.Наименование КАК Группа,
		|	Док.Студент.Наименование КАК СтудентФИО,
		|	Док.АдресатВыдачи.Наименование КАК Адресат,
		|	Док.Куратор.КраткоеФИО КАК Куратор,
		|	Док.Утверждена КАК Утверждена
		|ИЗ
		|	Документ.ХарактеристикаСтудента КАК Док
		|ГДЕ
		|	Док.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата,
		|	Док.Номер";
	Выборка = Запрос.Выполнить().Выбрать();

	ШрифтШапкиТабл = Новый Шрифт("Times New Roman", 10, Истина);
	ШрифтСтроки = Новый Шрифт("Times New Roman", 10, Ложь);
	ЛинияСетки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	Заголовки = Новый Массив;
	Заголовки.Добавить("Номер / Дата");
	Заголовки.Добавить("Группа");
	Заголовки.Добавить("ФИО обучающегося");
	Заголовки.Добавить("Адресат выдачи");
	Заголовки.Добавить("Куратор");
	Заголовки.Добавить("Статус утверждения");

	Для Индекс = 1 По 6 Цикл
		Яч = ТабДок.Область("R5C" + Формат(Индекс, "ЧГ=0"));
		Яч.Шрифт = ШрифтШапкиТабл;
		Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Яч.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Яч.Текст = Заголовки[Индекс - 1];
		Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
	КонецЦикла;

	Стр = 6;
	Пока Выборка.Следующий() Цикл
		Значения = Новый Массив;
		Значения.Добавить(СокрЛП(Выборка.Номер) + " от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
		Значения.Добавить(Выборка.Группа);
		Значения.Добавить(Выборка.СтудентФИО);
		Значения.Добавить(Выборка.Адресат);
		Значения.Добавить(Выборка.Куратор);
		Значения.Добавить(?(Выборка.Утверждена, "Утверждена", "На согласовании"));
		Для Индекс = 1 По 6 Цикл
			Яч = ТабДок.Область("R" + Формат(Стр, "ЧГ=0") + "C" + Формат(Индекс, "ЧГ=0"));
			Яч.Шрифт = ШрифтСтроки;
			Яч.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Яч.Текст = Значения[Индекс - 1];
			Яч.Обвести(ЛинияСетки, ЛинияСетки, ЛинияСетки, ЛинияСетки);
		КонецЦикла;
		Стр = Стр + 1;
	КонецЦикла;
	Возврат ТабДок;
КонецФункции

Функция ПолучитьСсылкуХарактеристикаПоНомеру(НомерДок = "000000002") Экспорт
	Возврат Документы.ХарактеристикаСтудента.НайтиПоНомеру(НомерДок, Дата("20261101"));
