Функция НайтиИлиСоздатьДолжность(Наименование, Категория, Описание)
	Найденная = Справочники.Должности.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат Найденная;
	КонецЕсли;
	Об = Справочники.Должности.СоздатьЭлемент();
	Об.Наименование = Наименование;
	Об.КатегорияПерсонала = Категория;
	Об.ОписаниеФункций = Описание;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция НайтиИлиСоздатьПодразделение(Наименование, Родитель, Руководитель, Адрес, Телефон, ЭтоГруппа = Ложь)
	Найденная = Справочники.СтруктурныеПодразделения.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат Найденная;
	КонецЕсли;
	Если ЭтоГруппа Тогда
		Об = Справочники.СтруктурныеПодразделения.СоздатьГруппу();
	Иначе
		Об = Справочники.СтруктурныеПодразделения.СоздатьЭлемент();
		Об.РуководительПодразделения = Руководитель;
		Об.АдресКорпуса = Адрес;
		Об.Телефон = Телефон;
	КонецЕсли;
	Об.Наименование = Наименование;
	Если ЗначениеЗаполнено(Родитель) Тогда
		Об.Родитель = Родитель;
	КонецЕсли;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

