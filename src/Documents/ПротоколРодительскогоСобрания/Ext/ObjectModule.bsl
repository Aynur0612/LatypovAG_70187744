Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.УчетДисциплинарныхЗамечанийИМер.Записывать = Истина;
	Для Каждого Стр Из ПрисутствиеРодителей Цикл
		Дв = Движения.УчетДисциплинарныхЗамечанийИМер.Добавить();
		Дв.Период = Дата;
		Дв.Студент = Стр.Студент;
		Дв.УчебнаяГруппа = УчебнаяГруппа;
		Дв.ВидЗамечания = Стр.ВидЗамечания;
		Дв.КоличествоЗамечаний = 0;
		Дв.КоличествоПрофилактическихБесед = ?(Стр.ПроведенаИндивидуальнаяБеседа, 1, 0);
		Дв.ШтрафныеБаллыДисциплины = 0;
	КонецЦикла;
КонецПроцедуры
