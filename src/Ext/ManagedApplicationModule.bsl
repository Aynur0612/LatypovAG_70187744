Процедура ПриНачалеРаботыСистемы()
	Парам = СокрЛП(ПараметрЗапуска);
	Если Парам = "АвтоЗаполнениеСПК" Тогда
		Попытка
			ИнициализацияТестовыхДанныхСПК.ВыполнитьПолноеЗаполнениеИПроверкуБазы();
		Исключение
			ЛогОш = Новый ТекстовыйДокумент;
			ЛогОш.ДобавитьСтроку(ОписаниеОшибки());
			ЛогОш.Записать("C:\Temp\vkr_1c\seed_error.txt");
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
	ИначеЕсли Парам = "" Или Парам = "UI_MAIN_DESK" Тогда
		ОткрытьФорму("Документ.ХарактеристикаСтудента.ФормаСписка");
	ИначеЕсли Парам = "UI_CATALOGS" Тогда
		ОткрытьФорму("Справочник.Студенты.ФормаСписка");
		ОткрытьФорму("Справочник.УчебныеГруппы.ФормаСписка");
	ИначеЕсли Парам = "UI_ATTENDANCE" Тогда
		ОткрытьФорму("РегистрНакопления.УчетПосещаемостиИПропусков.ФормаСписка");
		ОткрытьФорму("Документ.ВедомостьУчетаПосещаемости.ФормаСписка");
	ИначеЕсли Парам = "UI_ATTENDANCE_DOC" Тогда
		СсВед = АналитикаИПечатьОтчетовКуратора.ПолучитьСсылкуВедомостьПосещаемости();
		Если ЗначениеЗаполнено(СсВед) Тогда
			ОткрытьФорму("Документ.ВедомостьУчетаПосещаемости.ФормаОбъекта", Новый Структура("Ключ", СсВед));
		КонецЕсли;
	ИначеЕсли Парам = "UI_GRADES" Тогда
		ОткрытьФорму("Документ.АттестационнаяВедомостьГруппы.ФормаСписка");
		ОткрытьФорму("РегистрСведений.СводныеПоказателиУспеваемостиИЗадолженностей.ФормаСписка");
	ИначеЕсли Парам = "UI_EVENTS" Тогда
		ОткрытьФорму("РегистрНакопления.РейтингВоспитательнойАктивности.ФормаСписка");
		ОткрытьФорму("Документ.ПротоколВоспитательногоМероприятия.ФормаСписка");
	ИначеЕсли Парам = "UI_CHAR_CARD_2" Тогда
		СсДок = АналитикаИПечатьОтчетовКуратора.ПолучитьСсылкуХарактеристикаПоНомеру("000000002");
		Если ЗначениеЗаполнено(СсДок) Тогда
			ОткрытьФорму("Документ.ХарактеристикаСтудента.ФормаОбъекта", Новый Структура("Ключ", СсДок));
		КонецЕсли;
	ИначеЕсли Парам = "UI_CHAR_CARD_1" Тогда
		СсДок = АналитикаИПечатьОтчетовКуратора.ПолучитьСсылкуХарактеристикаПоНомеру("000000001");
		Если ЗначениеЗаполнено(СсДок) Тогда
			ОткрытьФорму("Документ.ХарактеристикаСтудента.ФормаОбъекта", Новый Структура("Ключ", СсДок));
		КонецЕсли;
	ИначеЕсли Парам = "UI_BP_TASKS" Тогда
		ОткрытьФорму("БизнесПроцесс.СогласованиеИВыдачаХарактеристикиСтудента.ФормаСписка");
		ОткрытьФорму("Задача.ЗадачаПоВоспитательнойРаботе.ФормаСписка");
	ИначеЕсли Парам = "UI_PRINT_CHAR_2" Тогда
		ОткрытьФорму("Документ.ХарактеристикаСтудента.ФормаСписка");
		СсДок = АналитикаИПечатьОтчетовКуратора.ПолучитьСсылкуХарактеристикаПоНомеру("000000002");
		ТабДок = ФормированиеХарактеристикСПКСервер.СформироватьТабличныйДокументХарактеристикаСПК(СсДок);
		ТабДок.Показать("Печатная форма характеристики АУ «СПК» (Соколов А.А.)");
	ИначеЕсли Парам = "UI_PRINT_CHAR_1" Тогда
		ОткрытьФорму("Документ.ХарактеристикаСтудента.ФормаСписка");
		СсДок = АналитикаИПечатьОтчетовКуратора.ПолучитьСсылкуХарактеристикаПоНомеру("000000001");
		ТабДок = ФормированиеХарактеристикСПКСервер.СформироватьТабличныйДокументХарактеристикаСПК(СсДок);
		ТабДок.Показать("Печатная форма характеристики АУ «СПК» (Иванов И.И.)");
	ИначеЕсли Парам = "UI_PRINT_REP_1" Тогда
		ТабДок = АналитикаИПечатьОтчетовКуратора.СформироватьОтчетПосещаемость();
		ТабДок.Показать("Отчет: Сводная ведомость посещаемости и пропусков");
	ИначеЕсли Парам = "UI_PRINT_REP_2" Тогда
		ТабДок = АналитикаИПечатьОтчетовКуратора.СформироватьОтчетУспеваемость();
		ТабДок.Показать("Отчет: Анализ успеваемости и академических задолженностей");
	ИначеЕсли Парам = "UI_PRINT_REP_3" Тогда
		ТабДок = АналитикаИПечатьОтчетовКуратора.СформироватьОтчетРейтингАктивности();
		ТабДок.Показать("Отчет: Рейтинг воспитательной и общественной активности");
	ИначеЕсли Парам = "UI_PRINT_REP_5" Тогда
		ТабДок = АналитикаИПечатьОтчетовКуратора.СформироватьОтчетРеестрХарактеристик();
		ТабДок.Показать("Отчет: Реестр сформированных и утвержденных характеристик");
	КонецЕсли;
КонецПроцедуры
